# ══════════════════════════════════════════════════════════════
#  Inference Service — mflux
# ══════════════════════════════════════════════════════════════

## Model selection
# Options: flux2-klein-4b, flux2-klein-9b, z-image-turbo, z-image, dev, schnell
MFLUX_MODEL_ALIAS=z-image-turbo

# Quantisation level: 8 (8-bit) or null (no quant). 8-bit halves memory ~6 GB → ~3 GB.
MFLUX_QUANTIZE=8

## Generation defaults
# Distilled models (z-image-turbo, schnell) need only 4-8 steps.
# Non-distilled (flux2-klein-*, z-image, dev) need 20-50 steps.
MFLUX_DEFAULT_NUM_STEPS=6
MFLUX_DEFAULT_HEIGHT=1024
MFLUX_DEFAULT_WIDTH=1024

## Resource limits (prevents Mac from freezing)
# For a 48 GB M3 Max with 8-bit quant:  16 GB leaves ~10 GB headroom above the model
# For a 16 GB Mac:                        8 GB is safer
MFLUX_MLX_CACHE_LIMIT_GB=16
# Offload training data to disk instead of RAM
MFLUX_LOW_RAM=true
# CPU priority — higher = lower priority. Keens system responsive during generation
MFLUX_NICE_LEVEL=10

## Training defaults (LoRA)
# Epochs x Steps = total iterations. 3 x 9 = 27 is conservative; 50 x 9 = 450 for quality.
MFLUX_TRAINING_EPOCHS=3
MFLUX_TRAINING_STEPS=9
MFLUX_TRAINING_LEARNING_RATE=0.0001
# Lower = less memory. 768 for 48GB machines, 1024 for 64GB+
MFLUX_TRAINING_MAX_RESOLUTION=768

# Max request body in MB (training image uploads)
MFLUX_MAX_REQUEST_BODY_SIZE_MB=500

# Comma-separated paths to default LoRA weight files loaded at startup
# Example: MFLUX_LORA_PATHS=lora_weights/my_style_lora.safetensors,lora_weights/another.safetensors
MFLUX_LORA_PATHS=

# ══════════════════════════════════════════════════════════════
#  Web API — ASP.NET Core
# ══════════════════════════════════════════════════════════════
# URL of the inference service (in Docker, use http://inference-service:8000)
InferenceBaseUrl=http://localhost:8000

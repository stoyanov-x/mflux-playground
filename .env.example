# ── Inference Service ────────────────────────────────────────
MFLUX_MODEL_ALIAS=flux2-klein-4b
MFLUX_DEFAULT_NUM_STEPS=25
MFLUX_DEFAULT_HEIGHT=1024
MFLUX_DEFAULT_WIDTH=1024
MFLUX_QUANTIZE=8

# Resource limits (prevents Mac from freezing)
MFLUX_MLX_CACHE_LIMIT_GB=16
MFLUX_LOW_RAM=true
MFLUX_NICE_LEVEL=10

# Training defaults
MFLUX_TRAINING_EPOCHS=50
MFLUX_TRAINING_STEPS=9
MFLUX_TRAINING_LEARNING_RATE=0.0001

# Max request body in MB (training image uploads)
MFLUX_MAX_REQUEST_BODY_SIZE_MB=500

# Comma-separated paths to default LoRA weight files loaded at startup
MFLUX_LORA_PATHS=

# ── Web API ──────────────────────────────────────────────────
InferenceBaseUrl=http://localhost:8000

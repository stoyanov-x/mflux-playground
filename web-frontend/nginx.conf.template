server {
    listen 80;
    server_name localhost;
    root /usr/share/nginx/html;
    index index.html;

    # Allow large training image uploads (base64, 30 images ~150 MB)
    client_max_body_size 500M;

    # API proxy to inference service
    # INFERENCE_API_URL — set via env var (default: http://host.docker.internal:8000 on Mac)
    # Note: no trailing slash on proxy_pass — preserves the /api/v1/ prefix
    location /api/v1/ {
        proxy_pass ${INFERENCE_API_URL};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 300s;
        proxy_request_buffering off;
    }

    # API proxy to web API
    # WEB_API_URL — set via env var (default: http://web-api:8080)
    # Note: no trailing slash on proxy_pass — preserves the /api/generation/ prefix
    location /api/generation/ {
        proxy_pass ${WEB_API_URL};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 120s;
    }

    # SPA fallback — serve index.html for all other routes
    location / {
        try_files $uri $uri/ /index.html;
    }
}
